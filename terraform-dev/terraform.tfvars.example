aws_region    = "us-east-1"
domain        = "dhinrichs.dev"
platform_name = "mitto"

vpc_cidr           = "10.1.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

instance_type = "t3.small"
ebs_size_gb   = 20

# Contents of your ~/.ssh/id_ed25519.pub (or equivalent)
ssh_public_key = "ssh-ed25519 AAAA... your-key-here"

# Restrict to your own IP, e.g. "203.0.113.10/32" — get it with `curl ifconfig.me`
ssh_allowed_cidr = "0.0.0.0/0"

ecr_image_retention = 10

# Copy to .env and fill in your values before `docker compose up`
# Shared by every service in docker-compose.yml via env_file — service-specific
# URLs (DATABASE_URL, REDIS_URL, MITTO_BUILD_URL, etc.) are set directly in
# docker-compose.yml using Docker service names and don't belong here.

JWT_SECRET=change-me-min-32-characters-long
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-min-32-characters-long

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ECR_REGISTRY=

TF_CLOUD_TOKEN=
TF_CLOUD_ORG=mitto-sh

PLATFORM_DOMAIN=http://localhost:4000

# GitHub App private key: place the real .pem at mitto-infra/secrets/github-app-private-key.pem
# (mounted read-only into the api/build containers — path is set in docker-compose.yml)
